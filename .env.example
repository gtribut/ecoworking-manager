APP_NAME=Ecoworking
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Dev local : host admin (sous-domaine `.test` via /etc/hosts, ADR-0004).
# Prod (Clever Cloud) : https://admin.ecoworking.fr
APP_URL=http://admin.ecoworking.test

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
# Heures « métier » en heure locale du coworking (ADR-0010). Défaut du code :
# Europe/Paris — poser la même valeur partout (dev + prod).
APP_TIMEZONE=Europe/Paris

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=ecoworking
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# null = cookie scopé au host courant → sessions admin/portail isolées (ADR-0004)
SESSION_DOMAIN=null

# Sous-domaines (ADR-0004). Dev local = `.test` via /etc/hosts (cf. README).
# Prod = `.fr`. En test (Pest) ils sont forcés vides par phpunit.xml → routes
# sans contrainte de domaine, donc ne PAS compter sur ces valeurs pour les tests.
ADMIN_DOMAIN=admin.ecoworking.test
PORTAL_DOMAIN=portail.ecoworking.test
# Domaines stateful Sanctum mode SPA (ADR-0003). En prod : portail.ecoworking.fr
SANCTUM_STATEFUL_DOMAINS="${PORTAL_DOMAIN}"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Mot de passe du compte admin créé par `db:seed` (optionnel). Vide/absent :
# un mot de passe aléatoire est généré et affiché une seule fois à la création.
SEED_ADMIN_PASSWORD=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@ecoworking.fr"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Google OAuth (login admin, C2.2). Valeurs réelles dans le .env local / Clever
# Cloud uniquement — jamais commitées. hosted_domain = Workspace autorisé.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_HOSTED_DOMAIN=ecoworking.fr

VITE_APP_NAME="${APP_NAME}"

# Identité légale de l'émetteur — mentions obligatoires des factures (C6.2,
# CGI art. 289 / 242 nonies A). Valeurs réelles dans le .env local / Clever Cloud.
COMPANY_LEGAL_NAME="Ecoworking"
COMPANY_LEGAL_FORM="SARL"
COMPANY_CAPITAL=
COMPANY_SIRET=
COMPANY_RCS=
COMPANY_VAT_NUMBER=
COMPANY_ADDRESS_LINE1=
COMPANY_ADDRESS_LINE2=
COMPANY_POSTAL_CODE=
COMPANY_CITY="Lyon"
COMPANY_COUNTRY="France"
COMPANY_EMAIL=
COMPANY_PHONE=

# ── Observabilité (C10, BRIEF §16) — vides en dev (no-op), renseignées en prod
# Sentry (erreurs back + perf). DSN du projet ecoworking-laravel.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
# Sentry SPA (projet ecoworking-portal-react) — injecté au build Vite.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.2

# Laravel Pulse (perf interne, dashboard /pulse admin-only). Désactivable.
PULSE_ENABLED=true

# Healthchecks.io — surveillance des crons (une URL de check par job planifié).
HEALTHCHECK_MONTHLY_BILLING_URL=
HEALTHCHECK_OVERDUE_INVOICES_URL=

# Brevo — email transactionnel en PROD via driver API (dev = Mailpit ci-dessus).
# En prod (Clever Cloud) : MAIL_MAILER=brevo + BREVO_API_KEY renseignée.
# Transport câblé via AppServiceProvider (Mail::extend) + config services.brevo.
# Cf. todo_guillaume.
BREVO_API_KEY=
