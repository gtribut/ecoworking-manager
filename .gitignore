/vendor/
node_modules/
npm-debug.log
yarn-error.log
# Store pnpm : créé à la racine du dépôt si `pnpm install` est lancé dans le
# conteneur Sail au lieu de l'hôte (~300 Mo). Cf. docs/todo_guillaume.md C13.6.
.pnpm-store/

# Navigateurs Playwright (e2e C11.3) — binaires téléchargés localement
# (PLAYWRIGHT_BROWSERS_PATH partagé hôte/conteneur), jamais commités.
# Les sorties Playwright (traces, rapports) sont dans portal-spa/.gitignore.
/.playwright-browsers
# Captures d'écran des échecs Pest browser (suite e2e admin)
/tests/Browser/Screenshots/

# Laravel 4 specific
bootstrap/compiled.php
app/storage/

# Caches générés (package discovery) — jamais commités
/bootstrap/cache/*.php

# SQLite (projet sur PostgreSQL — pas de base SQLite versionnée)
/database/*.sqlite
/database/*.sqlite-journal

# Laravel 5 & Lumen specific
public/storage
public/hot

# Laravel 5 & Lumen specific with changed public path
public_html/storage
public_html/hot

storage/*.key
.env
.env.*
!.env.example
Homestead.yaml
Homestead.json
/.vagrant
.phpunit.result.cache

/public/build
# Build SPA portail (Vite → public/portal/, cf. BRIEF §6) — buildé en CI /
# au déploiement (`pnpm build` dans portal-spa/), jamais commité.
/public/portal
# Assets Filament publiés (régénérés par `artisan filament:assets`,
# via `filament:upgrade` au post-autoload-dump de composer) — non versionnés.
/public/css/filament
/public/js/filament
/public/fonts/filament
/storage/pail
.phpactor.json
auth.json

# VS Code — config locale user (préserver les settings partagés du repo)
.vscode/*.log
.vscode/*.local.json

# Foam — cache
.foam/

# Python — bytecode (scripts des skills .claude)
__pycache__/
*.py[cod]

# Laravel 13 / outillage moderne (complément scaffold)
*.log
.DS_Store
Thumbs.db
_ide_helper.php
/.phpunit.cache
/public/fonts-manifest.dev.json

# IDE/éditeurs tiers (on conserve .vscode partagé, cf. plus haut)
/.idea
/.nova
/.zed
/.cursor/
/.codex

# Claude Code — réglages locaux (non partagés avec l'équipe)
.claude/settings.local.json
