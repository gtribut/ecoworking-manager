/vendor/
node_modules/
npm-debug.log
yarn-error.log

# Laravel 4 specific
bootstrap/compiled.php
app/storage/

# Caches générés (package discovery) — jamais commités
/bootstrap/cache/*.php

# SQLite (projet sur PostgreSQL — pas de base SQLite versionnée)
/database/*.sqlite
/database/*.sqlite-journal

# Laravel 5 & Lumen specific
public/storage
public/hot

# Laravel 5 & Lumen specific with changed public path
public_html/storage
public_html/hot

storage/*.key
.env
Homestead.yaml
Homestead.json
/.vagrant
.phpunit.result.cache

/public/build
# Assets Filament publiés (régénérés par `artisan filament:assets`,
# via `filament:upgrade` au post-autoload-dump de composer) — non versionnés.
/public/css/filament
/public/js/filament
/public/fonts/filament
/storage/pail
.env.backup
.env.production
.phpactor.json
auth.json

# VS Code — config locale user (préserver les settings partagés du repo)
.vscode/*.log
.vscode/*.local.json

# Foam — cache
.foam/

# Python — bytecode (scripts des skills .claude)
__pycache__/
*.py[cod]

