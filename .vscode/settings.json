{
  "editor.wordWrap": "on",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "other": true,
      "comments": true,
      "strings": true
    }
  },

  "markdown.preview.fontSize": 15,
  "markdown.preview.lineHeight": 1.6,

  "foam.completion.useAlias": "always",
  "foam.openDailyNote.directory": "docs/notes",

  "cSpell.language": "en,fr",
  "cSpell.diagnosticLevel": "Hint",

  "markdownlint.config": {
    "MD013": false,
    "MD033": false,
    "MD041": false
  }
}
