{
  "compilerOptions": {
    "target": "ES2023",
    // `DOM` (review U5) : les callbacks `page.evaluate()`/`locator.evaluate()`
    // s'exécutent dans le navigateur, pas dans le process Node de test — sans
    // ce lib, `document`/`window`/`getComputedStyle` ne type-checkent pas
    // (jusqu'ici les specs évitaient ces globals dans `evaluate`, cf. e2e/bookings.spec.ts
    // qui ne s'appuie que sur `Date`, disponible sans DOM).
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,
    "erasableSyntaxOnly": true
  },
  "include": ["vite.config.ts", "playwright.config.ts", "e2e", "presentation"]
}
